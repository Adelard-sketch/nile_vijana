# Nile Vijana Creatives - backend secrets and environment settings.
# Copy this file to backend/.env and fill in the values. Never commit .env to Git
# and never put these keys in frontend JavaScript.

# --- App ---------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
# APP_URL=http://localhost/nilevijanacreatives/backend/public
# FRONTEND_URL=http://localhost/nilevijanacreatives/frontend
# APP_KEY=   (long random string: php -r "echo bin2hex(random_bytes(32));")

# --- Database ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_NAME=nile_vijana
DB_USER=root
DB_PASS=
DB_PREFIX=

# --- Paystack (https://dashboard.paystack.com/#/settings/developers) -----------
# Start with the TEST keys (sk_test_ / pk_test_). Swap in live keys for real money.
PAYMENT_GATEWAY=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Send creator withdrawals with Paystack Transfers (needs Transfers enabled on the account)
PAYSTACK_TRANSFERS=false

# --- Email (welcome emails, sign-in codes, Q&A answers) -------------------------
# MAIL_DRIVER=log writes emails to storage/logs/mail/ instead of sending them.
MAIL_DRIVER=log
MAIL_FROM=no-reply@nilevijanacreatives.com
MAIL_FROM_NAME="Nile Vijana Creatives"
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# tls for port 587, ssl for port 465
SMTP_ENCRYPTION=tls

# --- Spotify (optional, for the Spotify search on the Music page) ---------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- SMS (optional booking and payout alerts) --------------------------------
AT_USERNAME=sandbox
AT_API_KEY=
